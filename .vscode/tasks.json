{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build (MinGW)",
            "type": "shell",
            "command": "${workspaceFolder}\\build.bat",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "run",
            "type": "shell",
            "command": "${workspaceFolder}\\build\\OpenGL_OBJ_Viewer.exe",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "build (MinGW)",
            "problemMatcher": []
        }
    ]
}
